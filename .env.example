# Set a TypeSafe key or an OpenRouter key. The bot reads these at startup.
TYPESAFE_API_KEY=

# Optional custom building designer. Without this, Jev uses building templates.
OPENROUTER_API_KEY=
OPENROUTER_BUILD_MODEL=anthropic/claude-fable-5.1
# auto: prefer OpenRouter designs; fall back to Jev templates after two failures.
# jev: always use templates. openrouter: require the custom designer.
BUILD_DESIGNER=auto

# Optional LLM adviser after repeated failures (uses the same OpenRouter key).
# auto: ask for bounded recovery steps; off: use ordinary retries/blockers only.
RECOVERY_ADVISER=auto
OPENROUTER_RECOVERY_MODEL=anthropic/claude-fable-5.1

# Jev decisions can use either service. By default, prefer a TypeSafe key;
# otherwise use the OpenRouter key. This does not change the design model.
# JEV_PROVIDER=typesafe
# JEV_PROVIDER=openrouter
# OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# Minecraft server to join
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Jev
# Pin this if auto-detection picks the wrong protocol, e.g. 1.20.4
# MC_VERSION=
# "offline" for a cracked/LAN server, "microsoft" for a real account
MC_AUTH=offline
# Optional memory namespace. Change when replacing a world at the same address.
# MC_WORLD_ID=my-survival-world

# Players allowed to request operator commands in natural language or "Jev run /...".
# Empty disables operator commands.
# The bot also needs server operator permissions; commands are never autonomous.
MC_COMMAND_USERS=

# Optional local 3D observatory. Leave unset to disable it.
# JEV_DASHBOARD_PORT=3040
# Uses the installed Minecraft client for block textures; colors are the fallback.
# Override the detected installation when needed. Assets stay local.
# MINECRAFT_CLIENT_JAR=/path/to/minecraft/versions/26.1/26.1.jar
# MINECRAFT_HOME=/path/to/minecraft
