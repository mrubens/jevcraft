# ---- Required: one model key and a Minecraft server ------------------------

# Jev through TypeSafe. Get a key at https://typesafe.ai/
TYPESAFE_API_KEY=

# The Minecraft Java 26.1 server the bot joins, and the name it plays as.
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Jev
# "offline" for a LAN/offline-mode server, "microsoft" for a real account.
MC_AUTH=offline

# ---- Recommended ------------------------------------------------------------

# Local 3D Observatory showing the world and every Jev judgment.
# Open http://127.0.0.1:3040/?session=live once the bot is running.
JEV_DASHBOARD_PORT=3040

# ---- Optional: generative model for custom building designs and stuck recovery

# Creative mode only. With it, "Jev build a cherry mansion" in Creative gets a
# custom design; in Survival, or without it, Jev configures building templates.
OPENROUTER_API_KEY=
OPENROUTER_BUILD_MODEL=anthropic/claude-opus-5.5
# auto: custom designs in Creative when a key is set, templates otherwise.
# jev: always templates. openrouter: require custom designs in Creative.
# Survival always uses templates.
BUILD_DESIGNER=auto
# jev: Jev picks a code-checked recovery action after repeated failures.
# off: ordinary retries only.
RECOVERY_ADVISER=jev

# ---- Optional: everything else ---------------------------------------------

# Jev decisions can also go through OpenRouter instead of TypeSafe.
# JEV_PROVIDER=typesafe
# JEV_PROVIDER=openrouter
# OPENROUTER_JEV_MODEL=typesafe/jev-1.13
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Pin the protocol version if auto-detection picks the wrong one.
# MC_VERSION=26.1
# A separate memory namespace when you replace the world at the same address.
# MC_WORLD_ID=my-survival-world

# Players allowed to ask for server commands ("Jev make it daytime").
# Empty disables them. The bot also needs operator permission on the server.
MC_COMMAND_USERS=

# Observatory textures come from your installed Minecraft client; block colours
# are the fallback. Point at a different installation if needed.
# MINECRAFT_CLIENT_JAR=/path/to/minecraft/versions/26.1/26.1.jar
# MINECRAFT_HOME=/path/to/minecraft
